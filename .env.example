# ─── DATABASE ─────────────────────────────────────────────────────────────────
# Required for local development. Use a managed PostgreSQL URL for production.
DATABASE_URL="postgresql://postgres:password@localhost:5432/societybuy?schema=public"

# ─── AUTH ─────────────────────────────────────────────────────────────────────
# Required: generate with `openssl rand -base64 32`
AUTH_SECRET="your-auth-secret-here-generate-with-openssl-rand-base64-32"
# Required: the public URL of your app
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"

# ─── APP ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="SocietyBuy"

# ─── PAYMENT GATEWAY (Razorpay) ───────────────────────────────────────────────
# Optional for basic dev mode — the app uses a simulator when these are absent.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# ─── EMAIL (Resend / SMTP) ────────────────────────────────────────────────────
# Optional — emails are logged to console in dev mode when absent.
RESEND_API_KEY=""
EMAIL_FROM="noreply@societybuy.in"

# ─── OBJECT STORAGE (Cloudflare R2 / AWS S3) ─────────────────────────────────
# Optional — files are stored locally in /public/uploads in dev mode.
STORAGE_PROVIDER="local"        # "local" | "s3" | "r2"
S3_BUCKET_NAME=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""                  # For R2: https://<accountid>.r2.cloudflarestorage.com

# ─── ENVIRONMENT ──────────────────────────────────────────────────────────────
NODE_ENV="development"
NEXT_PUBLIC_ENV="development"
# Set to "true" to enable dev payment simulator (auto-enabled when RAZORPAY keys absent)
PAYMENT_DEV_MODE="true"
